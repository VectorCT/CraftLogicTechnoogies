# Public (exposed to the browser)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Microsoft Clarity project ID. Loaded only after the visitor accepts analytics cookies.
NUXT_PUBLIC_CLARITY_ID=

# Server-only
NUXT_CONTACT_INBOX=hello@example.com

# Contact form email via Microsoft Graph (app registration with Mail.Send application permission).
# Leave blank in development: enquiries are accepted and only the reference is logged.
NUXT_MAIL_TENANT_ID=
NUXT_MAIL_CLIENT_ID=
NUXT_MAIL_CLIENT_SECRET=
NUXT_MAIL_SENDER=website@example.com
